<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_inherit_fne" model="ir.ui.view">
        <field name="name">account.move.form.inherit.fne</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- Bouton pour normaliser les factures -->
                <button name="action_send_to_fne"
                        string="Normaliser Facture"
                        type="object"
                        class="oe_highlight"
                        invisible="fne_state in ('success', 'pending') or move_type == 'out_refund'"/>

                <!-- Bouton pour certifier les factures d'avoir -->
                <button name="action_certify_refund"
                        string="Certifier Avoir"
                        type="object"
                        class="oe_highlight"
                        invisible="move_type != 'out_refund' or refund_fne_state in ('success', 'pending')"/>

                <!-- Bouton pour voir la réponse FNE -->
                <button name="action_view_fne_response"
                        string="Voir la réponse FNE"
                        type="object"
                        class="btn-link"
                        invisible="not fne_response_data or fne_state != 'success'"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <!--
                    Panneau FNE : la structure est un <div> plutôt qu'un <group>
                    afin de maîtriser entièrement la mise en page (libellés en
                    colonne, valeurs alignées, badge de statut discret).
                -->
                <div class="o_fne_panel" invisible="move_type == 'out_refund'">
                    <div class="o_fne_panel_head">
                        <span class="o_fne_panel_title">Information FNE</span>
                        <field name="fne_state"
                               widget="badge"
                           class="o_fne_status"
                           decoration-success="fne_state == 'success'"
                           decoration-info="fne_state == 'pending'"
                           decoration-danger="fne_state == 'error'"
                           decoration-muted="fne_state == 'draft'"/>
                    </div>
                    <div class="o_fne_rows">
                        <div class="o_fne_row" invisible="not fne_reference">
                            <span class="o_fne_label">Référence</span>
                            <span class="o_fne_value o_fne_value_code">
                                <field name="fne_reference" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                        <div class="o_fne_row" invisible="not fne_ncc">
                            <span class="o_fne_label">NCC</span>
                            <span class="o_fne_value o_fne_value_code">
                                <field name="fne_ncc" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                        <div class="o_fne_row o_fne_row_wide" invisible="fne_state != 'success'">
                            <span class="o_fne_label">Lien de vérification</span>
                            <span class="o_fne_value">
                                <field name="fne_url" widget="url" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                        <div class="o_fne_row o_fne_row_wide" invisible="fne_state != 'error'">
                            <span class="o_fne_label">Message d'erreur</span>
                            <span class="o_fne_value o_fne_value_error">
                                <field name="fne_error_message" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Informations FNE pour les factures d'avoir -->
                <div class="o_fne_panel" invisible="move_type != 'out_refund'">
                    <div class="o_fne_panel_head">
                        <span class="o_fne_panel_title">Information FNE avoir</span>
                        <field name="refund_fne_state"
                               widget="badge"
                           class="o_fne_status"
                           decoration-success="refund_fne_state == 'success'"
                           decoration-info="refund_fne_state == 'pending'"
                           decoration-danger="refund_fne_state == 'error'"
                           decoration-muted="refund_fne_state == 'draft'"/>
                    </div>
                    <div class="o_fne_rows">
                        <div class="o_fne_row" invisible="not refund_fne_reference">
                            <span class="o_fne_label">Référence</span>
                            <span class="o_fne_value o_fne_value_code">
                                <field name="refund_fne_reference" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                        <div class="o_fne_row" invisible="not refund_fne_ncc">
                            <span class="o_fne_label">NCC</span>
                            <span class="o_fne_value o_fne_value_code">
                                <field name="refund_fne_ncc" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                        <div class="o_fne_row o_fne_row_wide" invisible="refund_fne_state != 'success'">
                            <span class="o_fne_label">Lien de vérification</span>
                            <span class="o_fne_value">
                                <field name="refund_fne_url" widget="url" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                        <div class="o_fne_row o_fne_row_wide" invisible="refund_fne_state != 'error'">
                            <span class="o_fne_label">Message d'erreur</span>
                            <span class="o_fne_value o_fne_value_error">
                                <field name="refund_fne_error_message" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                        <div class="o_fne_row" invisible="not reversed_entry_id">
                            <span class="o_fne_label">Facture d'origine</span>
                            <span class="o_fne_value">
                                <field name="reversed_entry_id" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
