<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fne</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <app name="account" position="inside">
                <h2>Configuration FNE</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">API FNE</span>
                            <div class="text-muted">
                                Configuration de l'API FNE
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label class="col-lg-3" for="fne_api_url">URL de l'API</label>
                                    <field name="fne_api_url" class="col-lg-9"
                                           placeholder="http://serveur-fne/ws/external/invoices"/>
                                </div>
                                <div class="row mt16">
                                    <label class="col-lg-3" for="fne_api_key">Clé API</label>
                                    <field name="fne_api_key" class="col-lg-9" password="True"/>
                                </div>
                                <div class="row mt16">
                                    <label class="col-lg-3" for="fne_refund_api_url">URL des avoirs</label>
                                    <field name="fne_refund_api_url" class="col-lg-9"
                                           placeholder="http://serveur-fne/ws/external/invoices/{invoice_id}/refund"/>
                                </div>
                                <div class="row mt16">
                                    <label class="col-lg-3" for="fne_timeout">Timeout (s)</label>
                                    <field name="fne_timeout" class="col-lg-9"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Identifiants FNE</span>
                            <div class="text-muted">
                                Ces valeurs doivent correspondre à celles enregistrées dans le système FNE
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label class="col-lg-3" for="fne_establishment">Établissement</label>
                                    <field name="fne_establishment" class="col-lg-9"/>
                                </div>
                                <div class="row mt16">
                                    <label class="col-lg-3" for="fne_point_of_sale">Point de vente</label>
                                    <field name="fne_point_of_sale" class="col-lg-9"/>
                                </div>
                                <div class="row mt16">
                                    <label class="col-lg-3" for="fne_amount_unit">Unité des montants</label>
                                    <field name="fne_amount_unit" class="col-lg-9"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </app>
        </field>
    </record>
</odoo>
